{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brandsmith",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "keep_vars": true
}
